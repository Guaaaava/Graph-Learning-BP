    "hidden_dim": 64,
    "num_layers": 3
  },
  "training": {
    "epochs": 200,
    "batch_size": 32,
    "learning_rate": 0.001,
    "tau_init": 5.0,
    "tau_min": 0.1,
    "tau_decay": 0.98,
    "weight_decay": 0.0001,
    "max_grad_norm": 5.0,
    "lr_min": 1e-05,
    "deterministic": true
  },
  "objective": {
    "beta": null,
    "gamma": null,
    "kappa": null,
    "eta": null,
    "prediction_variance_floor": 1e-06,
    "compute_dtype": "float64"
  },
  "bp": {
    "num_particles": 10000,
    "num_iterations": 3,
    "chunk_size": 256,
    "compute_dtype": "float64",
    "measurement_variance_floor": 0.0,
    "damping": 0.0,
    "message_tolerance": 1e-08,
    "early_stopping": false
  },
  "evaluation": {
    "outage_threshold": 3.0,
    "alpha": 0.05,
    "edge_threshold": 0.5,
    "bp_repeats": 1,
    "bootstrap_samples": 2000,
    "covariance_rtol": 1e-12,
    "outage_thresholds": [
      0.5,
      1.0,
      2.0,
      3.0,
      5.0,
      10.0
    ],
    "coverage_levels": [
      0.5,
      0.8,
      0.9,
      0.95,
      0.99
    ],
    "ess_fraction_threshold": 0.1
  },
  "split_sizes": {
    "train": 2000,
    "val": 500,
    "test": 500
  }

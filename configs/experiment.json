{
  "experiment_id": "five-anchors-los",
  "seeds": {
    "data": 100,
    "training": 100,
    "bp": 700,
    "bootstrap": 700
  },
  "data": {
    "num_agents_min": 25,
    "num_agents_max": 35,
    "area_size": 100.0,
    "comm_radius": 30.0,
    "initial_covariance": 25.0,
    "base_noise_std": 0.5,
    "distance_noise_scale": 0.05,
    "communication_cost_scale": 1.0,
    "measurement_encoding": "ieee754-binary32-canonical-finite"
